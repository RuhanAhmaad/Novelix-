# NOVELIX 2.2 Environment Configuration Template

# ─── Firebase Web / Client Configuration ───
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key_here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
NEXT_PUBLIC_FIREBASE_APP_ID=your_firebase_app_id
NEXT_PUBLIC_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# ─── Firebase Admin Credentials (Server-Side Only) ───
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxx@your_project_id.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─── ImgBB Image Upload ───
IMGBB_API_KEY=your_imgbb_api_key_here
NEXT_PUBLIC_IMGBB_API_KEY=your_imgbb_api_key_here

# ─── Google OAuth (Firebase Authentication) ───
GOOGLE_CLIENT_ID=your_firebase_web_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_firebase_web_client_id.apps.googleusercontent.com

# ─── Google Drive Dedicated OAuth 2.0 Web Client ───
# Scopes: https://www.googleapis.com/auth/drive.readonly https://www.googleapis.com/auth/userinfo.email https://www.googleapis.com/auth/userinfo.profile
GOOGLE_DRIVE_CLIENT_ID=your_drive_oauth_client_id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_DRIVE_CLIENT_ID=your_drive_oauth_client_id.apps.googleusercontent.com

# Server-Side Only Secret (Set in functions/.env or Firebase Secret Manager - NEVER in frontend)
# GOOGLE_DRIVE_CLIENT_SECRET=your_google_client_secret_here

# ─── Token Encryption (for OAuth token secure server storage) ───
TOKEN_ENCRYPTION_SECRET=your_32_character_encryption_secret_here!

# ─── App URLs ───
NEXT_PUBLIC_SITE_URL=http://localhost:3000
