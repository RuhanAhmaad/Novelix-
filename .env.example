# NOVELIX 2.1 Environment Configuration

# ─── Supabase (Public — safe in client) ───
NEXT_PUBLIC_SUPABASE_URL=https://gzwpfvhmjweeydiwdsga.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# ─── Supabase Service Role (Server-side only — NEVER expose to client) ───
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── ImgBB Image Upload ───
# For production: use a server-side endpoint — never expose this key in the client
IMGBB_API_KEY=your_imgbb_api_key_here
# NEXT_PUBLIC_IMGBB_API_KEY=  # Only set if you accept the security tradeoff

# ─── Google OAuth (for Supabase Auth + Google Drive) ───
# Obtain from: console.cloud.google.com → APIs & Services → Credentials
# Required scopes: https://www.googleapis.com/auth/drive.file
# Add redirect URI: https://<your-project>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ─── Token Encryption (for Google Drive OAuth refresh tokens) ───
# Use a 32+ character random string — generate with: openssl rand -hex 32
TOKEN_ENCRYPTION_SECRET=your_32_char_minimum_encryption_secret

# ─── App URLs ───
NEXT_PUBLIC_SITE_URL=https://your-domain.com
# For local dev:
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
